{
  "autoRestore": true,
  "autoRestoreSettleMs": 2500,
  "agentResume": true,
  "agentResumeCommands": {
    "agy": {
      "resume": "--conversation {value}",
      "continue": ""
    },
    "antigravity": {
      "resume": "--conversation {value}",
      "continue": ""
    },
    "opencode": {
      "resume": "attach http://127.0.0.1:4096 --dir \"$PWD\" --session {value}",
      "continue": "attach http://127.0.0.1:4096 --dir \"$PWD\" --continue"
    },
    "kilo": {
      "resume": "attach http://127.0.0.1:4097 --dir \"$PWD\" --session {value}",
      "continue": "attach http://127.0.0.1:4097 --dir \"$PWD\" --continue"
    },
    "codex": {
      "resume": "-c check_for_update_on_startup=false resume {value}",
      "continue": "-c check_for_update_on_startup=false"
    }
  },
  "startupDelayMs": 3000,
  "startupBatchSize": 5,
  "startupBatchDelayMs": 10000,
  "startupReadyTimeoutMs": 60000,
  "startupAbortOnFailure": false,
  "requireSessionId": [
    "opencode",
    "kilo"
  ]
}
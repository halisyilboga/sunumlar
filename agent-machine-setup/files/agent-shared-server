#!/bin/zsh
# Runs one shared headless server for opencode or kilo, started by launchd
# (~/Library/LaunchAgents/dev.agent-shared-server.<name>.plist).
# herdr panes attach to it instead of each running a private ~1 GB server:
#   opencode attach http://127.0.0.1:4096 --session <id>
#   kilo attach     http://127.0.0.1:4097 --session <id>
# Goes through an interactive login zsh so PATH/API keys match a normal pane.
# Must never inherit HERDR_* vars, or every session's status is reported to one pane.
name="$1"; port="$2"
[ -n "$name" ] && [ -n "$port" ] || { echo "usage: $0 <opencode|kilo> <port>" >&2; exit 2; }
cd "$HOME"
exec env -u HERDR_ENV -u HERDR_PANE_ID -u HERDR_SOCKET_PATH -u HERDR_TAB_ID \
  -u HERDR_WORKSPACE_ID -u HERDR_BIN_PATH \
  /bin/zsh -lic "unset HERDR_ENV HERDR_PANE_ID HERDR_SOCKET_PATH HERDR_TAB_ID HERDR_WORKSPACE_ID HERDR_BIN_PATH; exec $name serve --hostname 127.0.0.1 --port $port" </dev/null
